    "Tungsten Edge is still running. You can try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钨极还在运行，可以重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge is still running. You can try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge仍在執行，可以再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edgeはまだ実行中です。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge läuft noch. Du kannst es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge est toujours en cours d’exécution. Vous pouvez réessayer."
          }
        },
        "es": {
