        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스 키는 유효하지 않습니다. 이메일에서 키 전체를 복사하여 다시 붙여넣으십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот лицензионный ключ недействителен. Скопируйте ключ из письма целиком и вставьте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu lisans anahtarı geçerli değil. Anahtarın tamamını e-postanızdan kopyalayıp yeniden yapıştırın."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लाइसेंस कुंजी मान्य नहीं है। अपने ईमेल से पूरी कुंजी कॉपी करके फिर से पेस्ट करें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa giấy phép này không hợp lệ. Hãy sao chép toàn bộ khóa từ email của bạn rồi dán lại."
          }
        }
      }
    },
