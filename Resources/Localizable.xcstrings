    "Paste it into a feedback message or send it to us. It contains only the app, system and display details shown below — no personal information.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以粘贴到反馈里，或直接发给我们。内容就是下面这些：只有应用、系统和显示器的信息，不含个人信息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste it into a feedback message or send it to us. It contains only the app, system and display details shown below — no personal information."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以貼到意見回饋裡，或直接傳給我們。內容就是下方這些：只有 App、系統和顯示器的資訊，不含個人資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックにペーストするか、そのままお送りください。内容は以下のとおりで、アプリ、システム、ディスプレイの情報のみです。個人情報は含まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge sie in eine Feedback-Nachricht ein oder sende sie uns. Sie enthalten nur die unten gezeigten Angaben zu App, System und Displays – keine persönlichen Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez-les dans un message de commentaires ou envoyez-les-nous. Elles ne contiennent que les détails ci-dessous sur l’app, le système et les écrans — aucune information personnelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pégala en un mensaje de comentarios o envíanosla. Solo contiene los datos de la app, el sistema y las pantallas que se muestran abajo; ninguna información personal."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Pégala en un mensaje de comentarios o envíanosla. Solo contiene los datos de la app, el sistema y las pantallas que se muestran abajo; ninguna información personal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole em uma mensagem de feedback ou envie para nós. Contém apenas os detalhes do app, do sistema e das telas mostrados abaixo — nenhuma informação pessoal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole numa mensagem de comentários ou envie-nos. Contém apenas os detalhes da app, do sistema e dos ecrãs mostrados abaixo — nenhuma informação pessoal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incollale in un messaggio di feedback o inviacele. Contengono solo i dettagli su app, sistema e schermi mostrati qui sotto: nessuna informazione personale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백 메시지에 붙여넣거나 저희에게 보내 주세요. 아래에 보이는 앱, 시스템, 디스플레이 정보만 들어 있으며 개인 정보는 포함되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте эту информацию в сообщение с отзывом или отправьте нам. Она содержит только сведения о приложении, системе и дисплеях, показанные ниже, — никаких персональных данных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu bir geri bildirim mesajına yapıştırın veya bize gönderin. Yalnızca aşağıda gösterilen uygulama, sistem ve ekran bilgilerini içerir — kişisel bilgi içermez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे फ़ीडबैक संदेश में पेस्ट करें या हमें भेजें। इसमें सिर्फ़ नीचे दिखाई गई ऐप, सिस्टम और डिस्प्ले की जानकारी है — कोई निजी जानकारी नहीं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dán thông tin này vào tin nhắn phản hồi hoặc gửi cho chúng tôi. Thông tin chỉ gồm chi tiết về ứng dụng, hệ thống và màn hình hiển thị bên dưới — không có thông tin cá nhân."
          }
        }
      }
    },
