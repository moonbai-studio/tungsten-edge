    "It may have been moved or deleted. Remove it and add it again.": {
      "comment": "反馈失败 · 附件在发送前被移走或删除",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被移动或删除。请移除后重新添加一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have been moved or deleted. Remove it and add it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被移動或刪除。請移除後再重新加入一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動または削除された可能性があります。いったん削除して、もう一度追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wurde vielleicht bewegt oder gelöscht. Entferne ihn und füge ihn erneut hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a peut-être été déplacée ou supprimée. Retirez-la, puis ajoutez-la à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya movido o eliminado. Quítalo y vuelve a añadirlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya movido o eliminado. Quítalo y agrégalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode ter sido movido ou apagado. Remova-o e adicione-o novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ter sido movido ou apagado. Remova-o e volte a adicioná-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere stato spostato o eliminato. Rimuovilo e aggiungilo di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동되었거나 삭제되었을 수 있습니다. 제거한 후 다시 추가하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, оно было перемещено или удалено. Удалите его и добавьте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınmış veya silinmiş olabilir. Çıkarıp yeniden ekleyin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है इसे मूव या डिलीट कर दिया गया हो। इसे हटाएँ और फिर से जोड़ें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp có thể đã bị di chuyển hoặc xóa. Hãy xóa tệp khỏi danh sách rồi thêm lại."
          }
        }
      }
    },
    "Keep in Dock": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞中保留"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep in Dock"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在Dock上"
          }
        },
        "ja": {
