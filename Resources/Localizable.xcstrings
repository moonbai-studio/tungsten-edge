    "Adds a spot on the taskbar for parking files. Dropping a file there doesn’t move or copy it — Tungsten Edge just remembers where it lives.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a spot on the taskbar for parking files. Dropping a file there doesn’t move or copy it — Tungsten Edge just remembers where it lives."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务条上多一个临时存放文件的格子。拖进去的文件不会被移动或复制，只是记住位置。"
          }
        }
      }
    },
