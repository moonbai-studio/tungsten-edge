    "Tungsten Edge will restart itself once you grant it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授权后钨极会自动重启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge will restart itself once you grant it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授權後Tungsten Edge會自行重新啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度許可すると、Tungsten Edgeは自動的に再起動します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du sie erneut erteilst, startet sich Tungsten Edge von selbst neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge redémarrera de lui-même une fois l’autorisation réaccordée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge se reiniciará automáticamente cuando vuelvas a concederle el permiso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge se reiniciará automáticamente cuando vuelvas a otorgarle el permiso."
          }
