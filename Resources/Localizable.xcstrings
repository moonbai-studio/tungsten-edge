    "Turn on Tungsten Edge in %@. This window closes by itself once you do, and the taskbar finishes starting.": {
      "comment": "%@ 是系统设置里的权限路径，随 macOS 版本不同",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在%@中，打开 Tungsten Edge 钨极的开关。开启后本窗口会自动关闭，Dock 栏会继续启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Tungsten Edge in %@. This window closes by itself once you do, and the taskbar finishes starting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在%@中打開Tungsten Edge的開關。打開後這個視窗會自動關閉，工作列也會繼續啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でTungsten Edgeをオンにしてください。オンにするとこのウインドウは自動的に閉じ、タスクバーの起動が完了します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Tungsten Edge unter %@. Sobald du das getan hast, schließt sich dieses Fenster von selbst und die Taskleiste startet vollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Tungsten Edge dans %@. Cette fenêtre se ferme alors d’elle-même et la barre des tâches termine son démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Tungsten Edge en %@. Esta ventana se cerrará sola cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Tungsten Edge en %@. Esta ventana se cerrará automáticamente cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Tungsten Edge em %@. Esta janela se fecha sozinha quando você fizer isso, e a barra de tarefas termina de iniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Tungsten Edge em %@. Esta janela fecha-se sozinha assim que o fizer e a barra de tarefas conclui o arranque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Tungsten Edge in %@. Questa finestra si chiude da sola quando lo fai e la barra delle applicazioni completa l’avvio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 Tungsten Edge를 켜십시오. 켜면 이 윈도우가 자동으로 닫히고 작업 표시줄이 시작됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Tungsten Edge здесь: %@. Окно закроется само, и панель задач завершит запуск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu konumda Tungsten Edge’in anahtarını açın: %@. Bunu yaptığınızda bu pencere kendiliğinden kapanır ve görev çubuğunun başlatılması tamamlanır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में Tungsten Edge चालू करें। चालू करते ही यह विंडो अपने आप बंद हो जाएगी और टास्कबार पूरी तरह शुरू हो जाएगा।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật Tungsten Edge trong %@. Cửa sổ này sẽ tự đóng ngay khi bạn bật, và thanh tác vụ sẽ khởi động xong."
          }
        }
      }
    },
