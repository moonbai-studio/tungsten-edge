    "Predict full-screen transitions to prevent taskbar flicker": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测全屏切换，消除 Dock 栏闪烁"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predict full-screen transitions to prevent taskbar flicker"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測全螢幕切換，避免工作列閃動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーン切り替えを予測してタスクバーのちらつきを防ぐ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
