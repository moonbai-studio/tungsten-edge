    "All attachments together must be 40 MB or smaller.": {
      "comment": "反馈附件被拒 · 合计超 40MB",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有附件加起来不能超过 40 MB。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All attachments together must be 40 MB or smaller."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有附件加起來不得超過40 MB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルの合計は40 MB以下にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Anhänge zusammen dürfen höchstens 40 MB groß sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ensemble des pièces jointes ne doit pas dépasser 40 Mo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adjuntos no pueden superar 40 MB en total."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adjuntos no pueden superar 40 MB en total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os anexos juntos devem ter no máximo 40 MB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os anexos em conjunto não podem exceder 40 MB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli allegati insieme non possono superare 40 MB."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 첨부 파일의 합계가 40MB 이하여야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
