    "You can attach up to 3 files. Remove one first.": {
      "comment": "反馈附件被拒 · 超过 3 个",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多只能添加 3 个附件，请先移除一个。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can attach up to 3 files. Remove one first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多只能加入3個附件，請先移除一個。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付できるファイルは3つまでです。1つ削除してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst höchstens 3 Dateien anhängen. Entferne zuerst eine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez joindre 3 fichiers au maximum. Retirez-en un d’abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes adjuntar hasta 3 archivos. Quita uno primero."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes adjuntar hasta 3 archivos. Quita uno primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode anexar até 3 arquivos. Remova um primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode anexar até 3 ficheiros. Remova primeiro um."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi allegare al massimo 3 file. Rimuovine prima uno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 최대 3개까지 첨부할 수 있습니다. 먼저 하나를 제거하십시오."
