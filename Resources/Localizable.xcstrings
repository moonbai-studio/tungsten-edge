    "The screen will flash once when you apply this.": {
      "comment": "整屏**唯一**的闪屏预告——owner 2026-08-28 看过实机后把说明文字全删，只留下这一句。别把它挪回段落里，也别让它随勾选状态出现/消失（引导窗高度只在建窗时量一次）。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen will flash once when you apply this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用时屏幕会闪一下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用時螢幕會閃一下。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用すると画面が一度点滅します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anwenden blinkt der Bildschirm einmal auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran clignotera une fois au moment d’appliquer ce réglage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla parpadeará una vez al aplicarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla parpadeará una vez al aplicarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela vai piscar uma vez ao aplicar isto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã vai piscar uma vez ao aplicar isto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo lampeggerà una volta all’applicazione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용하면 화면이 한 번 깜박입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран один раз мигнет при применении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu uyguladığınızda ekran bir kez yanıp sönecek."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे लागू करने पर स्क्रीन एक बार झिलमिलाएगी।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình sẽ nhấp nháy một lần khi bạn áp dụng thay đổi này."
          }
        }
      }
    },
