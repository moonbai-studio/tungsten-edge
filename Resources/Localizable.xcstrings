            "value": "Tungsten Edge sigue en ejecución. Puedes intentarlo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tungsten Edge ainda está em execução. Você pode tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tungsten Edge continua em execução. Pode voltar a tentar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge è ancora in esecuzione. Puoi riprovare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge가 아직 실행 중입니다. 다시 시도할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
