            "value": "이미 구독 중"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже подписаны"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten abonesiniz"
          }
        },
