        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave de licença não é válida. Copie a chave completa do seu e-mail e cole-a novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave di licenza non è valida. Copia l’intera chiave dalla tua email e incollala di nuovo."
