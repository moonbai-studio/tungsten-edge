            "value": "Tungsten Edge अभी भी चल रहा है। आप फिर कोशिश कर सकते हैं।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge vẫn đang chạy. Bạn có thể thử lại."
          }
        }
      }
    },
    "Tungsten Edge just lost its Accessibility permission, so the taskbar has been put away. Turn Tungsten Edge back on in %@.": {
      "comment": "%@ 同上",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钨极刚才失去了辅助功能权限，Dock 栏已经收起。请在%@中重新打开 Tungsten Edge 钨极的开关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge just lost its Accessibility permission, so the taskbar has been put away. Turn Tungsten Edge back on in %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge剛才失去了輔助使用權限，工作列已經收起。請在%@中重新打開Tungsten Edge的開關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edgeのアクセシビリティの許可が失われたため、タスクバーを格納しました。%@でTungsten Edgeをもう一度オンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge hat gerade seine Bedienungshilfen-Berechtigung verloren, deshalb wurde die Taskleiste eingeklappt. Aktiviere Tungsten Edge unter %@ wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge vient de perdre son autorisation d’accessibilité ; la barre des tâches a donc été retirée. Réactivez Tungsten Edge dans %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge acaba de perder el permiso de accesibilidad, por lo que se ha ocultado la barra de tareas. Vuelve a activar Tungsten Edge en %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge acaba de perder el permiso de accesibilidad, por lo que se ocultó la barra de tareas. Vuelve a activar Tungsten Edge en %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tungsten Edge acabou de perder a permissão de Acessibilidade, então a barra de tarefas foi recolhida. Ative o Tungsten Edge novamente em %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tungsten Edge acabou de perder a permissão de Acessibilidade, pelo que a barra de tarefas foi recolhida. Volte a ativar o Tungsten Edge em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge ha appena perso l’autorizzazione di accessibilità, quindi la barra delle applicazioni è stata nascosta. Riattiva Tungsten Edge in %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge가 방금 손쉬운 사용 권한을 잃어 작업 표시줄을 숨겼습니다. %@에서 Tungsten Edge를 다시 켜십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение Tungsten Edge только что лишилось разрешения универсального доступа, поэтому панель задач убрана. Снова включите Tungsten Edge здесь: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge Erişilebilirlik iznini az önce kaybetti, bu yüzden görev çubuğu gizlendi. Şu konumda Tungsten Edge’in anahtarını yeniden açın: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge की ऐक्सेसिबिलिटी अनुमति अभी-अभी हट गई, इसलिए टास्कबार हटा दिया गया है। %@ में Tungsten Edge को फिर से चालू करें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge vừa mất quyền Trợ năng nên thanh tác vụ đã được cất đi. Hãy bật lại Tungsten Edge trong %@."
          }
        }
      }
    },
    "Tungsten Edge needs this permission to read and manage your windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge 需要这项权限来读取和操作窗口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge needs this permission to read and manage your windows."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge需要這項權限來讀取與管理你的視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edgeはウインドウを読み取って操作するために、この許可を必要とします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge benötigt diese Berechtigung, um deine Fenster zu lesen und zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge a besoin de cette autorisation pour lire et gérer vos fenêtres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge necesita este permiso para leer y gestionar tus ventanas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge necesita este permiso para leer y administrar tus ventanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tungsten Edge precisa desta permissão para ler e gerenciar suas janelas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tungsten Edge precisa desta permissão para ler e gerir as suas janelas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge richiede questa autorizzazione per leggere e gestire le finestre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge가 윈도우를 읽고 관리하려면 이 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению Tungsten Edge нужно это разрешение, чтобы получать сведения об окнах и управлять ими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge’in pencerelerinizi okuyabilmesi ve yönetebilmesi için bu izne ihtiyacı var."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge को आपकी विंडो पढ़ने और प्रबंधित करने के लिए इस अनुमति की ज़रूरत है।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge cần quyền này để đọc và quản lý các cửa sổ của bạn."
          }
        }
      }
    },
