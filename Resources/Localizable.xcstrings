    "Star Tungsten Edge on GitHub — a free way to help it get better.": {
      "comment": "⚠️ 中文与官网 tungstenedge.app 订阅区下面那句 Star 请求逐字同源，改这里就要同步改官网。调子必须比上面订阅正文更淡——它是顺手帮个忙，不能压过留邮箱的真实理由。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star Tungsten Edge on GitHub — a free way to help it get better."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 点个免费的 Star，支持钨极变得更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到GitHub給Tungsten Edge一顆星——不花錢也能幫它變得更好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubでTungsten EdgeにStarを付けると、無料で開発を応援できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Tungsten Edge auf GitHub einen Stern – so unterstützt du die Weiterentwicklung, ohne Geld auszugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une étoile à Tungsten Edge sur GitHub — un coup de pouce gratuit pour l’aider à progresser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una estrella a Tungsten Edge en GitHub: una forma gratuita de ayudar a que mejore."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una estrella a Tungsten Edge en GitHub: una forma gratuita de ayudar a que mejore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma estrela ao Tungsten Edge no GitHub — um jeito gratuito de ajudar a melhorá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma estrela ao Tungsten Edge no GitHub – uma forma gratuita de ajudar a melhorá-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti una stella a Tungsten Edge su GitHub: un modo gratuito per aiutarlo a migliorare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 Tungsten Edge에 Star를 눌러 주십시오. 무료로 개선을 도울 수 있는 방법입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте Tungsten Edge звезду на GitHub — бесплатный способ помочь ему стать лучше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub’da Tungsten Edge’e yıldız verin — daha iyi hale gelmesine ücretsiz yardım etmenin bir yolu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर Tungsten Edge को स्टार करें — इसे बेहतर बनाने में मदद करने का एक मुफ़्त तरीक़ा।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gắn sao cho Tungsten Edge trên GitHub — một cách miễn phí để giúp ứng dụng ngày càng tốt hơn."
          }
        }
      }
    },
