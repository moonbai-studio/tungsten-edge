    "Open System Settings and go to Desktop & Dock (on macOS 12, Dock & Menu Bar).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从系统设置进入「桌面与程序坞」（macOS 12 为「程序坞与菜单栏」）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings and go to Desktop & Dock (on macOS 12, Dock & Menu Bar)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請打開「系統設定」並前往「桌面與Dock」（macOS 12為「Dock與選單列」）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開いて「デスクトップとDock」に進んでください（macOS 12では「Dockとメニューバー」）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Systemeinstellungen und gehe zu „Schreibtisch & Dock“ (unter macOS 12: „Dock & Menüleiste“)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages Système, puis allez dans « Bureau et Dock » (sur macOS 12, « Dock et barre des menus »)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema y ve a Escritorio y Dock (en macOS 12, Dock y barra de menús)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Configuración del Sistema y ve a Escritorio y Dock (en macOS 12, Dock y barra de menús)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os Ajustes do Sistema e vá para Mesa e Dock (no macOS 12, Dock e Barra de Menus)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra as Definições do Sistema e aceda a Secretária e Dock (no macOS 12, Dock e barra de menus)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di Sistema e vai in “Scrivania e Dock” (su macOS 12, “Dock e barra dei menu”)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정을 열고 ‘데스크탑 및 Dock’(macOS 12에서는 ‘Dock 및 메뉴 막대’) 패널로 이동하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Системные настройки и перейдите в раздел «Рабочий стол и Dock» (в macOS 12 — «Dock и строка меню»)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları’nı açıp Masaüstü ve Dock bölümüne gidin (macOS 12’de Dock ve Menü Çubuğu)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग खोलें और डेस्कटॉप और Dock पर जाएँ (macOS 12 में, Dock और मेन्यू बार)।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt hệ thống rồi đi tới Màn hình nền & Dock (trên macOS 12 là Dock & Thanh menu)."
          }
        }
      }
    },
