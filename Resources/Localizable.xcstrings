            "value": "读取超时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out while reading"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取逾時"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みがタイムアウトしました"
          }
        },
        "de": {
          "stringUnit": {
